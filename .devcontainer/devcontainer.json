{
  "name": "go-quicraft",
  "build": {
    "dockerfile": "../build/docker/devcontainer/Dockerfile",
    "context": "..",
    "target": "dev",
    "args": {
      "GO_IMAGE": "golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf"
    },
    "options": ["--secret", "id=gomodauth,src=${localWorkspaceFolder}/.devcontainer/.env"]
  },
  "workspaceFolder": "/src",
  "workspaceMount": "source=${localWorkspaceFolder},target=/src,type=bind",
  "remoteUser": "dev",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.testFlags": ["-race", "-count=1", "-v"],
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--timeout=5m"]
      }
    }
  },
  "forwardPorts": []
}
