# Module credentials for the project forge. Copy to .devcontainer/.env (which
# git and every Docker build context ignore), chmod 600, and fill in your own
# Gitea account and access token. That account already reads every
# github.com/jeremyhahn/* repository the build needs; no other token is used.
#
# .env is the only place these values live. The devcontainer image builds
# mount it as the gomodauth BuildKit secret for `go mod download`, the compose
# services and `make docker-make` load it at run time, and the perf-* targets
# read it for the benchmark images.
#
# The lines are sourced by sh and read by compose and `docker run --env-file`,
# which takes quotes literally: keep every value unquoted.
GOPRIVATE=github.com/jeremyhahn/*
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=url.http://your-gitea-user:your-gitea-access-token@forge.example/jeremyhahn/.insteadOf
GIT_CONFIG_VALUE_0=https://github.com/jeremyhahn/
