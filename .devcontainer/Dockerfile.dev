FROM golang:1.26.6-bookworm

# Install build and test dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    make \
    git \
    bc \
    && rm -rf /var/lib/apt/lists/*

# Install CI tooling.
#
# The golangci-lint version MUST equal GOLANGCI_VERSION in the Makefile, which
# is the single source of truth and which quality.yml also matches. Docker
# cannot read a make variable, so `make check-tool-versions` asserts the pins
# agree; it runs as part of `make ci`. This file said v2.7.2 while CI ran
# v2.12.2 — a devcontainer that lints against a different rule set from CI
# passes while proving nothing.
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.12.2 && \
    go install github.com/securego/gosec/v2/cmd/gosec@latest && \
    go install golang.org/x/vuln/cmd/govulncheck@latest && \
    go install github.com/sonatype-nexus-community/nancy@latest && \
    curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin

WORKDIR /app

# Cache module downloads
COPY go.mod go.sum* ./
RUN go mod download 2>/dev/null || true

# Copy project source
COPY . .

# Entrypoint configures QUIC UDP buffer sizes at container startup.
COPY .devcontainer/entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["make", "ci"]
