# Dockerfile.integration - Multi-stage build for integration testing.
#
# Stage 1 (builder): compiles the integration test binary.
# Stage 2 (test-runner): runs the compiled integration test binary.

# ---------------------------------------------------------------------------
# Stage 1: Build
# ---------------------------------------------------------------------------
FROM golang:1.27.3-bookworm AS builder

WORKDIR /app

# Download the module cache in its own layer. Credentials for the project
# forge arrive as the optional gomodauth BuildKit secret (the K=V lines of
# .devcontainer/.env), mounted for this RUN only: sourced, never written to a
# layer or a command line. With no secret, modules resolve from the public
# proxy, so a module only the forge serves (go-enclave) fails the build here,
# loudly. This RUN is byte-identical in every image that downloads such a
# module (test/buildgates/module_download_test.go). Requires BuildKit.
COPY go.mod go.sum* ./
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -s /run/secrets/gomodauth ]; then \
      set -a; . /run/secrets/gomodauth; set +a; \
      echo "==> go mod download: Gitea module credentials mounted"; \
    else \
      echo "==> go mod download: no module credentials mounted; github.com/jeremyhahn/* resolves from the public proxy only"; \
    fi; \
    go mod download

# Copy the full source tree and build.
COPY . .

# Build the integration test binary. -c compiles without running, and
# -tags=integration selects the integration test files.
#
# No fallback and no suppressed stderr: a failed compile must fail the build.
# `go test -c` on a package with no test files writes nothing and exits 0, so
# `test -s` catches an empty build and `-test.list` proves the binary contains
# tests.
RUN set -eux; \
    go test -c -o /integration-tests -tags=integration ./test/integration/e2e/...; \
    test -s /integration-tests; \
    /integration-tests -test.list '.*' | grep -q '^Test'

# ---------------------------------------------------------------------------
# Stage 2: Test runner
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS test-runner

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lists/*

COPY --from=builder /integration-tests /usr/local/bin/integration-tests

# Entrypoint configures QUIC UDP buffer sizes at container startup.
RUN printf '#!/bin/sh\n\
echo 7500000 > /proc/sys/net/core/rmem_max 2>/dev/null || true\n\
echo 7500000 > /proc/sys/net/core/wmem_max 2>/dev/null || true\n\
exec "$@"\n' > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh", "integration-tests"]
