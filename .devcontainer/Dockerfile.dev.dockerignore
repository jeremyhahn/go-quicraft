# BuildKit reads this file instead of the root .dockerignore when it builds
# .devcontainer/Dockerfile.dev. It repeats every root entry except .git/: the
# dev image runs `make ci`, whose test/releasability gate reads the git index
# (`git ls-files`), so this one image keeps the repository metadata. Every
# other image still builds without it. test/buildgates fails if a root entry is
# missing here, and if .devcontainer/.env is missing from any ignore file.

# Build artifacts
build/coverage/
build/quicraft

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test data (created by integration tests running as root in Docker)
**/data/
integration-test.log

# Rust build artifacts (openraft benchmark)
test/performance/openraft/target/

# Go workspace (breaks sub-module Docker builds)
go.work
go.work.sum

# Agent and editor context files: the same list .gitattributes keeps out of
# every archive, enforced by test/releasability.
**/CLAUDE.md
**/AGENTS.md
**/.claude
**/.serena
.cursor/
.codex/

# The rest of the .gitattributes exclusion list. No image build reads them.
.github/workflows/automerge.yml
.github/workflows/revert-red-main.yml
.release-allowed-signers

# Module credentials (.devcontainer/.env.example). The build mounts them as a
# BuildKit secret; the COPY of the whole context must never carry the file.
.devcontainer/.env
