.build-cache/
*.log
*.test
*.out
*.prof
build/
data/

# Performance test generated artifacts
test/performance/openraft/target/
test/performance/perfcompare
test/performance/perfcompare.remote

# test/performance/profiles/ is not ignored: it holds the measured data of
# record (stored results, captured machine specifications, generated documents
# and analysis.md), some of it from machines that are no longer available.

# Snapshot trees a test rooted at the package directory instead of t.TempDir().
pkg/shard-*/

# Local session notes
resume.txt

.serena
go.work
go.work.sum

# Analysers built by `make install-lint`, kept repo-local so `make lint` runs a
# binary built with this repo's Go.
.tools/

# Module credentials for the benchmark image builds, read by the perf-*
# targets (test/performance/README.md). Never commit a token.
.devcontainer/.env
