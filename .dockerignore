# Version control. Several Dockerfiles COPY the whole build context. Only the
# dev image reads git metadata (its releasability gate), and it has its own
# .devcontainer/Dockerfile.dev.dockerignore, so keep history out of the rest.
# Every entry below must also appear there (test/buildgates).
.git/

# Build artifacts
build/coverage/
build/quicraft

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test data (created by integration tests running as root in Docker)
**/data/
integration-test.log

# Rust build artifacts (openraft benchmark)
test/performance/openraft/target/

# Go workspace (breaks sub-module Docker builds)
go.work
go.work.sum

# Agent and editor context files. They are published (.gitattributes), but no
# image runs them; test/releasability pins these entries.
**/CLAUDE.md
**/AGENTS.md
**/.claude
**/.serena
.cursor/
.codex/

# The private forge's workflows and the release trust anchor (the .gitattributes
# exclusions). No image build reads them.
.github/workflows/automerge.yml
.github/workflows/revert-red-main.yml
.release-allowed-signers

# Module credentials for the benchmark image builds (test/performance/README.md).
# Without this, the COPY of the whole context would put the token in a layer
# before the BuildKit secret mount. test/buildgates pins this together with
# .gitignore.
.devcontainer/.env
